<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="20dp"
    android:elevation="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dolita"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:tint="#FFFFFF"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Rate Selector Tabs -->
    <LinearLayout
        android:id="@+id/rate_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/tabs_background"
        android:padding="4dp"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tab_usd"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="USD"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/tab_selected"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tab_eur"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="EUR"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#88FFFFFF"
            android:background="@android:color/transparent"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tab_usdt"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="USDT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#88FFFFFF"
            android:background="@android:color/transparent"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

    <!-- Rate Display Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/rate_card_background"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_rate_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dólar BCV"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_rate_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$0,00"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_rate_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="↑ 0,00%"
            android:textSize="12sp"
            android:textColor="#4CAF50" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="#22FFFFFF" />

    <!-- Calculator -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALCULADORA"
        android:textSize="11sp"
        android:textColor="#888888"
        android:letterSpacing="0.15" />

    <EditText
        android:id="@+id/et_amount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:hint="Monto en USD"
        android:inputType="numberDecimal"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:textSize="22sp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/edit_background"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Bs. 0,00"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:gravity="center"
        android:fontFamily="sans-serif-medium" />

    <!-- Open App Button -->
    <Button
        android:id="@+id/btn_open_app"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="Abrir app completa"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#1E1E1E"
        android:background="@drawable/button_background" />

</LinearLayout>